# Producción (Vercel → Settings → Environment Variables) o desarrollo contra un Supabase remoto.
# Para desarrollo local NO hace falta: `npm run local:setup` genera .env.development.local solo.
# Para un proyecto nuevo, `npm run setup` genera .env.vercel con estas variables ya rellenas.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-o-publishable-key
# URL del servicio de correo (server/), p. ej. https://crm-correo.onrender.com
# VITE_EMAIL_API_URL=
